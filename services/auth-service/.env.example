PORT=
NODE_ENV=

# PostgreSQL — Prisma connection string
DATABASE_URL=

# JWT access token (short-lived, 15 min recommended)
JWT_SECRET=
JWT_EXPIRES_IN=

# JWT refresh token (long-lived, 7 days recommended)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Cookie signing secret (min 32 chars)
COOKIE_SECRET=

# Cookie SameSite policy. 'lax' is safe for same-site deployments (e.g. the
# Next.js rewrite path). Set to 'none' when the frontend calls the backend
# cross-site (Vercel -> Render), which also forces Secure.
COOKIE_SAME_SITE=lax

# bcrypt cost factor — 12 for production, 10 for development
BCRYPT_ROUNDS=

# AES-256-CBC key (64 hex chars = 32 bytes) for encrypting mobile & Aadhaar
AES_SECRET_KEY=

# AES-256-CBC IV (32 hex chars = 16 bytes)
AES_IV=

# Comma-separated allowed CORS origins
CORS_ORIGINS=

# Frontend origin used to build password-reset links (e.g. https://bses-gateway.vercel.app)
FRONTEND_URL=

# Notification service (internal) — loopback under the BSES supervisor
NOTIFICATION_SERVICE_URL=

# Shared secret for internal service-to-service calls
INTERNAL_SERVICE_SECRET=
