PORT=
NODE_ENV=

# PostgreSQL Database Connection
DATABASE_URL=

# MongoDB URI and GridFS Bucket Name
MONGODB_URI=
GRIDFS_BUCKET=

# File upload restrictions
MAX_FILE_SIZE_MB=
ALLOWED_MIME_TYPES=

# Notification service (internal) — loopback under the BSES supervisor
NOTIFICATION_SERVICE_URL=

# Encryption secrets
AES_SECRET_KEY=
AES_IV=

# JWT access-token secret (must match auth-service)
JWT_SECRET=

# CORS & Internal Secrets
CORS_ORIGINS=
INTERNAL_SERVICE_SECRET=

# OCR pipeline tuning (Render free tier ≈ 512 MB → be conservative)
OCR_WORKERS=1
OCR_MAX_ATTEMPTS=3
OCR_RETRY_BACKOFF_MS=30000
OCR_LANGUAGES=eng+hin
OCR_PDF_MAX_PAGES=25
OCR_PDF_RENDER_DIMENSION=1500
