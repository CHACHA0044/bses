PORT=
NODE_ENV=

# PostgreSQL Database Connection
DATABASE_URL=

# MongoDB URI and GridFS Bucket Name
MONGODB_URI=
GRIDFS_BUCKET=

# File upload restrictions
MAX_FILE_SIZE_MB=
ALLOWED_MIME_TYPES=

# Notification service (internal) — loopback under the BSES supervisor
NOTIFICATION_SERVICE_URL=

# Encryption secrets
AES_SECRET_KEY=
AES_IV=

# JWT access-token secret (must match auth-service)
JWT_SECRET=

# CORS & Internal Secrets
CORS_ORIGINS=
INTERNAL_SERVICE_SECRET=
