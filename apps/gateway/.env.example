PORT=
NODE_ENV=

# Downstream microservice base URLs.
# Under the BSES supervisor (single Render web service) these are injected
# automatically as http://127.0.0.1:<loopback-port> for each child service.
# When running the gateway standalone, set them to the real service URLs.
AUTH_SERVICE_URL=
CONSUMER_SERVICE_URL=
DOCUMENT_SERVICE_URL=
NOTIFICATION_SERVICE_URL=

# Rate limiting (milliseconds window + max requests per window)
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=
